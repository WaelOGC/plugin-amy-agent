# Service-local settings only. Do NOT put AI provider API keys here.
# Provider + key are stored in WordPress and sent per request.

AMY_SHARED_SECRET=change-me-to-a-long-random-string
PORT=8765
# Public origin of this service (no trailing slash). Used for Submit Idea attachment
# links in admin emails. Local: http://127.0.0.1:8765 — production: your Dokploy URL.
PUBLIC_BASE_URL=http://127.0.0.1:8765
